generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN") // SUPER_ADMIN, ADMIN, MANAGER, EDITOR
  avatar       String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs         ActivityLog[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  itemCount   Int       @default(0)
  isFeatured  Boolean   @default(false)
  order       Int       @default(0)
  actionText  String?   // e.g. "SHOP BANDS"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([order])
}

model Product {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  description    String?
  price          Float
  compareAtPrice Float?
  costPerItem    Float?
  sku            String?
  stock          Int              @default(0)
  lowStockAlert  Int              @default(5)
  isFeatured     Boolean          @default(false)
  isTrending     Boolean          @default(false)
  isNewArrival   Boolean          @default(false)
  isLimited      Boolean          @default(false)
  isOutOfStock   Boolean          @default(false)
  status         String           @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  rating         Float            @default(5.0)
  reviewCount    Int              @default(0)
  
  // JSON array strings for flexibility
  images         String           @default("[]") // Array of image URLs
  colors         String           @default("[]") // Array of hex color strings ["#dc2626", "#111111"]
  sizes          String           @default("[\"S\", \"M\", \"L\", \"XL\"]") // Array of sizes
  badges         String           @default("[]") // Array of badge tags ["NEW", "LIMITED"]
  tags           String           @default("[]") // Search keywords
  
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  variants       ProductVariant[]
  reviews        Review[]
  orderItems     OrderItem[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, categoryId])
  @@index([createdAt])
  @@index([stock])
  @@index([isFeatured])
  @@index([isNewArrival])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String   // e.g. "Black / XL"
  sku       String?
  price     Float
  stock     Int      @default(0)
  options   String   @default("{}") // JSON: {"color": "Black", "size": "XL"}
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  phone       String?
  avatar      String?
  totalOrders Int       @default(0)
  totalSpent  Float     @default(0.0)
  addresses   String    @default("[]") // JSON array of addresses
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  notes       String?
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders      Order[]

  @@index([status])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String?
  
  shippingAddress String      @default("{}") // JSON
  billingAddress  String      @default("{}") // JSON
  
  subtotal        Float
  discount        Float       @default(0.0)
  couponCode      String?
  shippingCost    Float       @default(0.0)
  tax             Float       @default(0.0)
  total           Float
  
  paymentMethod   String      @default("CREDIT_CARD") // CREDIT_CARD, PAYPAL, STRIPE, COD
  paymentStatus   String      @default("PAID") // PAID, PENDING, REFUNDED, FAILED
  orderStatus     String      @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  
  trackingNumber  String?
  carrier         String?
  notes           String?

  items           OrderItem[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([orderStatus])
  @@index([paymentStatus, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  title     String
  price     Float
  quantity  Int
  image     String?
  variant   String?  // e.g. "Size: L, Color: Black"
  total     Float

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String    @default("PERCENTAGE") // PERCENTAGE, FIXED, FREE_SHIPPING
  discountValue Float
  minOrderValue Float     @default(0.0)
  maxDiscount   Float?
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  usageLimit    Int?
  usageCount    Int       @default(0)
  status        String    @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model Banner {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  tag        String?  // e.g. "[ COLLECTION ]"
  buttonText String?  // e.g. "EXPLORE COLLECTION →"
  buttonLink String?
  image      String
  placement  String   @default("HERO") // HERO, TOUR_BANNER, FEATURED_DROP, MARQUEE, POPUP
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  metadata   String   @default("{}") // JSON
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, placement, order])
}

model WebContent {
  id         String   @id @default(uuid())
  sectionKey String   @unique // ABOUT_US, MOMENTS_GALLERY, MARQUEE_TEXT, FAQ, POLICIES
  title      String?
  subtitle   String?
  content    String   @default("{}") // JSON payload
  media      String   @default("[]") // JSON array of images/media
  updatedAt  DateTime @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  customerEmail String?
  rating       Int      @default(5)
  comment      String
  isApproved   Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId, isApproved])
}

model ActivityLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String   // e.g. "PRODUCT_CREATED", "ORDER_SHIPPED", "BANNER_UPDATED"
  entity    String   // e.g. "Product", "Order", "Banner"
  entityId  String?
  details   String?  // JSON or text
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // NEW_ORDER, LOW_STOCK, CUSTOMER_SIGNUP, SYSTEM
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON string
  group     String   @default("GENERAL") // GENERAL, STORE, PAYMENTS, SHIPPING, TAX, SEO
  updatedAt DateTime @updatedAt
}

model PublicationVersion {
  id            String    @id @default(uuid())
  versionNumber Int
  versionTag    String    // e.g. "v1.0", "v1.1"
  title         String    @default("Production Release")
  status        String    @default("PUBLISHED") // PUBLISHED, ARCHIVED, ROLLED_BACK
  summary       String    @default("[]") // JSON array of change strings
  diffDetails   String    @default("{}") // JSON detailed diff breakdown
  snapshot      String    // Full serialized JSON snapshot of all published storefront data
  publishedBy   String?   // Admin email or name
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([status, publishedAt])
  @@index([versionNumber])
}

model StorefrontDraft {
  id          String   @id @default("singleton_draft")
  snapshot    String   // JSON snapshot of current draft modifications
  isDirty     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

